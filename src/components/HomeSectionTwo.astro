---
const practiceAreas = [
	{
		es: 'Servicio binario',
		en: 'Binary service',
		descEs:
			'Soluciones digitales orientadas a la automatización de procesos legales y comerciales, con foco en precisión y seguridad. Diseñamos flujos binarios claros para la toma de decisiones, integrando datos, reglas de negocio y trazabilidad jurídica en una sola capa tecnológica.',
		descEn:
			'Digital solutions focused on automating legal and business processes with an emphasis on accuracy and security. We design clear binary flows for decision-making, integrating data, business rules, and legal traceability into a single technology layer.',
		desc2Es:
			'Nuestro equipo combina conocimiento técnico y jurídico para que tus sistemas cumplan con los estándares regulatorios y soporten auditorías futuras sin fricción.',
		desc2En:
			'Our team combines technical and legal expertise so your systems comply with regulatory standards and can withstand future audits without friction.',
		imgs: [
			'https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/546819/pexels-photo-546819.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/3730760/pexels-photo-3730760.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
	{
		es: 'Aseguraciones monetarias',
		en: 'Monetary assurances',
		descEs:
			'Estrategias jurídicas para blindar tu capital mediante garantías, colaterales y estructuras contractuales robustas. Evaluamos riesgos regulatorios, diseñamos esquemas de caución y acompañamos la negociación de pólizas y líneas de crédito complejas.',
		descEn:
			'Legal strategies to shield your capital through guarantees, collateral, and robust contractual structures. We assess regulatory risks, design collateral schemes, and support the negotiation of complex insurance policies and credit facilities.',
		desc2Es:
			'Te ayudamos a documentar adecuadamente cada obligación y a estructurar mecanismos de salida que reduzcan la exposición ante incumplimientos o cambios del mercado.',
		desc2En:
			'We help you properly document every obligation and structure exit mechanisms that reduce your exposure to defaults or market changes.',
		imgs: [
			'https://images.pexels.com/photos/4968631/pexels-photo-4968631.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/4386373/pexels-photo-4386373.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/6693661/pexels-photo-6693661.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
	{
		es: 'Recuperación monetaria',
		en: 'Monetary recovery',
		descEs:
			'Gestión integral de cobros, demandas, acuerdos y ejecución de garantías para recuperar valores adeudados. Combinamos negociación estratégica y litigio especializado para maximizar la probabilidad de recuperación y reducir el impacto financiero.',
		descEn:
			'Comprehensive management of collections, claims, settlements, and enforcement of guarantees to recover outstanding amounts. We combine strategic negotiation and specialized litigation to maximize recovery and reduce financial impact.',
		desc2Es:
			'Cada caso se analiza de forma individual para elegir la vía más eficiente: persuasiva, judicial o híbrida, siempre alineada con tus objetivos comerciales.',
		desc2En:
			'Each case is analyzed individually to choose the most efficient path—negotiation, litigation, or a hybrid approach—always aligned with your business goals.',
		imgs: [
			'https://images.pexels.com/photos/4386431/pexels-photo-4386431.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/4968383/pexels-photo-4968383.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/4968391/pexels-photo-4968391.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
	{
		es: 'Seguro de casa',
		en: 'Home insurance',
		descEs:
			'Acompañamiento legal en la contratación y reclamación de seguros de vivienda, desde daños materiales hasta pérdidas por eventos catastróficos. Protegemos el patrimonio familiar negociando con aseguradoras y documentando de forma sólida cada reclamación.',
		descEn:
			'Legal support in the contracting and claiming of home insurance, from material damage to losses caused by catastrophic events. We protect family assets by negotiating with insurers and thoroughly documenting every claim.',
		desc2Es:
			'Revisamos tus pólizas, exclusiones y condiciones particulares para que sepas exactamente qué está cubierto antes y después de cualquier incidente.',
		desc2En:
			'We review your policies, exclusions, and specific conditions so you know exactly what is covered both before and after any incident.',
		imgs: [
			'https://images.pexels.com/photos/106399/pexels-photo-106399.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/1396122/pexels-photo-1396122.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/323780/pexels-photo-323780.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
	{
		es: 'Seguro de automóvil',
		en: 'Car insurance',
		descEs:
			'Asesoría completa en siniestros vehiculares, responsabilidad civil y reclamaciones por daños. Analizamos pólizas, exclusiones y tiempos de respuesta para que recibas la indemnización que corresponde y evites conflictos innecesarios.',
		descEn:
			'Full advice on vehicle claims, civil liability, and damage recovery. We analyze policies, exclusions, and response times so you receive the compensation you are entitled to and avoid unnecessary disputes.',
		desc2Es:
			'Acompañamos todo el ciclo del siniestro: desde el levantamiento de información y reportes hasta negociaciones y, de ser necesario, acciones judiciales.',
		desc2En:
			'We accompany the entire claim cycle—from gathering information and filing reports to negotiations and, when necessary, court actions.',
		imgs: [
			'https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/97079/pexels-photo-97079.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/97075/pexels-photo-97075.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
	{
		es: 'Personal gerencial',
		en: 'Managerial staff',
		descEs:
			'Soporte jurídico especializado para directores, gerentes y alta dirección en materia de contratos, paquetes de compensación, confidencialidad y responsabilidad personal. Diseñamos marcos de gobierno corporativo que reducen la exposición individual y fortalecen la toma de decisiones.',
		descEn:
			'Specialized legal support for directors, managers, and senior executives on contracts, compensation packages, confidentiality, and personal liability. We design corporate governance frameworks that reduce individual exposure and strengthen decision-making.',
		desc2Es:
			'Trabajamos de forma cercana con recursos humanos y comités ejecutivos para alinear la estrategia legal con la cultura organizacional y los objetivos del negocio.',
		desc2En:
			'We work closely with HR and executive committees to align legal strategy with organizational culture and business objectives.',
		imgs: [
			'https://images.pexels.com/photos/1181400/pexels-photo-1181400.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/3184465/pexels-photo-3184465.jpeg?auto=compress&cs=tinysrgb&w=1600',
			'https://images.pexels.com/photos/1181533/pexels-photo-1181533.jpeg?auto=compress&cs=tinysrgb&w=1600',
		],
	},
];
---

<section
	id="services"
	class="relative bg-slate-950 py-16 text-white sm:py-20 lg:py-24 section-animate-init"
	data-practice-section
	data-animate-section
>
	<div class="absolute inset-0 bg-[url('/images/section02.webp')] bg-cover bg-center"></div>
	<div class="absolute inset-0 bg-black/70"></div>

	<div class="relative mx-auto flex max-w-6xl flex-col gap-8 px-6 lg:flex-row lg:gap-16 lg:px-8">
		<div class="w-full">
			<h2 class="text-2xl text-sky-400 tracking-[0.2em] sm:text-3xl">
				<span class="lang-es">SERVICIOS</span>
				<span class="lang-en">SERVICES</span>
			</h2>
			<div class="mt-3 h-0.5 w-24 bg-sky-400"></div>

			<p class="mt-6 max-w-2xl text-sm leading-relaxed text-slate-200 sm:text-base lang-es">
				World Solved Case ofrece asesoramiento jurídico sobre los aspectos de los negocios del cliente que pueden
				representar una contingencia potencial, incluyendo las siguientes áreas:
			</p>
			<p class="mt-6 max-w-2xl text-sm leading-relaxed text-slate-200 sm:text-base lang-en">
				World Solved Case provides legal advice on aspects of the client’s business that may represent potential
				contingencies, including the following areas:
			</p>

			<div class="mt-6 grid gap-4 text-sm text-slate-100 sm:grid-cols-2 lg:grid-cols-3">
				{practiceAreas.map((area, index) => (
					<button
						type="button"
						class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-700/70 bg-slate-900/70 px-4 py-3 text-left shadow-md shadow-black/40 backdrop-blur-sm transition hover:border-sky-400/80 hover:bg-slate-900"
						data-area-card
						data-index={index}
						data-title-es={area.es}
						data-title-en={area.en}
						data-desc-es={area.descEs}
						data-desc-en={area.descEn}
						data-desc2-es={area.desc2Es}
						data-desc2-en={area.desc2En}
						data-imgs={JSON.stringify(area.imgs)}
					>
						<div
							class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sky-500/90 text-white"
							aria-hidden="true"
						>
							{index === 0 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M4 4h16v6H4V4Zm2 2v2h12V6H6Zm-2 8h16v6H4v-6Zm2 2v2h12v-2H6Z"
									/>
								</svg>
							)}
							{index === 1 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M12 2l7 4v5c0 4.08-2.72 7.79-7 9c-4.28-1.21-7-4.92-7-9V6l7-4Zm0 2.15L7 6.7V11c0 3.03 1.94 5.8 5 6.86c3.06-1.06 5-3.83 5-6.86V6.7l-5-2.55ZM11 8v1h1.5a1.75 1.75 0 0 1 0 3.5H12v1h-2v-1h-.5A1.75 1.75 0 0 1 8 10.75V10h2v.75h2v-1.5h-1A1.75 1.75 0 0 1 11 8Z"
									/>
								</svg>
							)}
							{index === 2 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M5 4h14v2H5V4Zm2 4h8a4 4 0 0 1 0 8h-3v2l-4-3l4-3v2h3a2 2 0 0 0 0-4H7V8Z"
									/>
								</svg>
							)}
							{index === 3 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M12 3l8 6v10h-5v-5H9v5H4V9l8-6Zm0 2.2L6 10v7h1v-5h10v5h1v-7l-6-4.8Z"
									/>
								</svg>
							)}
							{index === 4 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M5.5 11L7 6h10l1.5 5H20a2 2 0 0 1 2 2v5h-2v-2H4v2H2v-5a2 2 0 0 1 2-2h1.5Zm2.3-3l-.6 2h9.6l-.6-2H7.8ZM7 16a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3Zm10 0a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3Z"
									/>
								</svg>
							)}
							{index === 5 && (
								<svg viewBox="0 0 24 24" class="h-5 w-5">
									<path
										fill="currentColor"
										d="M9 4a3 3 0 1 1-3 3a3 3 0 0 1 3-3Zm6 0a3 3 0 1 1-3 3a3 3 0 0 1 3-3ZM4 14.5A3.5 3.5 0 0 1 7.5 11H10a3.5 3.5 0 0 1 3.5 3.5V19H4v-4.5Zm10 0A3.5 3.5 0 0 1 17.5 11H18a3.5 3.5 0 0 1 3.5 3.5V19H14v-4.5Z"
									/>
								</svg>
							)}
						</div>
						<p class="mb-0 text-sm font-medium leading-snug text-slate-50">
							<span class="lang-es">{area.es}</span>
							<span class="lang-en">{area.en}</span>
						</p>
					</button>
				))}
			</div>
		</div>
	</div>

	<!-- Modal / carousel -->
	<div
		class="fixed inset-0 z-40 flex items-center justify-center bg-black/70 px-4 opacity-0 pointer-events-none transition-opacity duration-200"
		data-area-modal
	>
		<div class="absolute inset-0" data-area-backdrop></div>

		<div class="relative z-10 w-full max-w-3xl rounded-xl border border-slate-700/80 bg-slate-900/95 shadow-2xl shadow-black/70 backdrop-blur-md">
			<button
				type="button"
				class="absolute cursor-pointer right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-600/70 bg-slate-900/70 text-slate-300 text-sm hover:border-sky-400 hover:text-white"
				data-area-close
				aria-label="Cerrar"
			>
				×
			</button>

			<div class="grid gap-6 p-5 sm:p-7 lg:grid-cols-[1.1fr_minmax(0,1fr)] lg:gap-8">
				<div class="space-y-4">
					<h3 class="text-lg font-semibold tracking-[0.18em] text-sky-400 sm:text-xl">
						<span class="lang-es" data-modal-title-es></span>
						<span class="lang-en" data-modal-title-en></span>
					</h3>
					<p class="text-sm leading-relaxed text-slate-200 lang-es" data-modal-desc-es></p>
					<p class="text-sm leading-relaxed text-slate-200 lang-es" data-modal-desc2-es></p>

					<p class="text-sm leading-relaxed text-slate-200 lang-en" data-modal-desc-en></p>
					<p class="text-sm leading-relaxed text-slate-200 lang-en" data-modal-desc2-en></p>

					<div class="flex gap-3 pt-2 text-xs text-slate-400">
						<button
							type="button"
							class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-700/80 px-3 py-1.5 uppercase tracking-[0.18em] hover:border-sky-400 hover:text-sky-300"
							data-area-prev
						>
							<span>‹</span>
							<span>Prev</span>
						</button>
						<button
							type="button"
							class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-700/80 px-3 py-1.5 uppercase tracking-[0.18em] hover:border-sky-400 hover:text-sky-300"
							data-area-next
						>
							<span>Next</span>
							<span>›</span>
						</button>
					</div>
				</div>

				<div class="overflow-hidden rounded-lg border border-slate-700/70 bg-slate-950/60">
					<img
						src=""
						alt=""
						class="h-56 w-full object-cover opacity-100 transition-opacity duration-700 ease-out sm:h-64"
						loading="lazy"
						data-modal-img
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<script type="module">
	document.addEventListener('DOMContentLoaded', () => {
		const section = document.querySelector('[data-practice-section]');
		if (!section) return;

		const cards = Array.from(section.querySelectorAll('[data-area-card]'));
		const modal = section.querySelector('[data-area-modal]');
		const backdrop = section.querySelector('[data-area-backdrop]');
		const closeBtn = section.querySelector('[data-area-close]');
		const prevBtn = section.querySelector('[data-area-prev]');
		const nextBtn = section.querySelector('[data-area-next]');
		const titleEsEl = section.querySelector('[data-modal-title-es]');
		const titleEnEl = section.querySelector('[data-modal-title-en]');
		const descEsEl = section.querySelector('[data-modal-desc-es]');
		const descEnEl = section.querySelector('[data-modal-desc-en]');
		const desc2EsEl = section.querySelector('[data-modal-desc2-es]');
		const desc2EnEl = section.querySelector('[data-modal-desc2-en]');
		const imgEl = section.querySelector('[data-modal-img]');

		if (!modal || cards.length === 0) return;

		let currentIndex = 0;
		let currentImages = [];
		let currentImageIndex = 0;
		let imageTimer;

		const setImage = (src, alt) => {
			if (!imgEl) return;

			// start fade out
			imgEl.style.opacity = '0';

			const handleLoad = () => {
				imgEl.removeEventListener('load', handleLoad);
				requestAnimationFrame(() => {
					imgEl.style.opacity = '1';
				});
			};

			imgEl.addEventListener('load', handleLoad);
			imgEl.src = src;
			imgEl.alt = alt;
		};

		const setFromCard = (index) => {
			const card = cards[index];
			if (!card) return;

			const ds = card.dataset;

			if (titleEsEl) titleEsEl.textContent = ds.titleEs || '';
			if (titleEnEl) titleEnEl.textContent = ds.titleEn || '';
			if (descEsEl) descEsEl.textContent = ds.descEs || '';
			if (desc2EsEl) desc2EsEl.textContent = ds.desc2Es || '';
			if (descEnEl) descEnEl.textContent = ds.descEn || '';
			if (desc2EnEl) desc2EnEl.textContent = ds.desc2En || '';

			const imgs = ds.imgs ? JSON.parse(ds.imgs) : [];
			currentImages = Array.isArray(imgs) ? imgs : [];
			currentImageIndex = 0;

			const baseAlt = ds.titleEs || ds.titleEn || 'Service image';
			if (currentImages.length > 0) {
				setImage(currentImages[0], baseAlt + ' 1');
			}

			currentIndex = index;
		};

		const startImageTimer = () => {
			if (imageTimer) clearInterval(imageTimer);
			if (!currentImages || currentImages.length <= 1) return;

			const card = cards[currentIndex];
			const ds = card?.dataset || {};
			const baseAlt = ds.titleEs || ds.titleEn || 'Service image';

			imageTimer = setInterval(() => {
				currentImageIndex = (currentImageIndex + 1) % currentImages.length;
				const src = currentImages[currentImageIndex];
				setImage(src, `${baseAlt} ${currentImageIndex + 1}`);
			}, 2000);
		};

		const stopImageTimer = () => {
			if (imageTimer) {
				clearInterval(imageTimer);
				imageTimer = undefined;
			}
		};

		const openModal = (index) => {
			setFromCard(index);
			modal.classList.remove('opacity-0', 'pointer-events-none');
			modal.classList.add('opacity-100');
			startImageTimer();
		};

		const closeModal = () => {
			stopImageTimer();
			modal.classList.add('opacity-0', 'pointer-events-none');
			modal.classList.remove('opacity-100');
		};

		const showNext = () => {
			const next = (currentIndex + 1) % cards.length;
			setFromCard(next);
			startImageTimer();
		};

		const showPrev = () => {
			const prev = (currentIndex - 1 + cards.length) % cards.length;
			setFromCard(prev);
			startImageTimer();
		};

		cards.forEach((card, index) => {
			card.addEventListener('click', () => openModal(index));
		});

		closeBtn?.addEventListener('click', closeModal);
		backdrop?.addEventListener('click', closeModal);
		nextBtn?.addEventListener('click', showNext);
		prevBtn?.addEventListener('click', showPrev);

		document.addEventListener('keydown', (event) => {
			if (modal.classList.contains('pointer-events-none')) return;
			if (event.key === 'Escape') {
				closeModal();
			} else if (event.key === 'ArrowRight') {
				showNext();
			} else if (event.key === 'ArrowLeft') {
				showPrev();
			}
		});
	});
</script>