---
import CountrySelect from "../partials/CountrySelect.astro";
---

<section
	id="contacto"
	class="relative bg-slate-950 py-16 text-slate-50 sm:py-20 lg:py-24 mt-5 section-animate-init"
	data-animate-section
>
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-500/0 via-sky-500/60 to-sky-500/0"
	>
	</div>

	<div
		class="mx-auto flex max-w-6xl  mt-5 flex-col gap-10 px-6 lg:flex-row lg:items-start lg:gap-16 lg:px-8"
	>
		<div class="w-full lg:w-[50%]">
			<h2 class="text-2xl tracking-[0.2em] text-sky-400 sm:text-3xl">
				<span class="lang-es">SUSCRIBETE</span>
				<span class="lang-en">SUBSCRIBE</span>
			</h2>
			<div class="mt-3 h-0.5 w-20 bg-sky-500"></div>

			<p
				class="mt-6 text-sm leading-relaxed text-slate-300 sm:text-base lang-es"
			>
				Inscríbete en este formulario con la información correspondiente
				y explícanos tu caso detalladamente en el mensaje. Te
				responderemos lo más pronto posible.
			</p>
			<p
				class="mt-6 text-sm leading-relaxed text-slate-300 sm:text-base lang-en"
			>
				Fill out this form with your information and explain your case
				in detail in the message field. We will get back to you as soon
				as possible.
			</p>

			<div class="mt-6 space-y-1 text-xs text-slate-400">
				<p>
					<span class="lang-es">También puedes escribirnos a</span>
					<span class="lang-en">You can also write to</span>
					<a
						href="mailto:info@worldsolvedcase.com"
						class="ml-1 text-sky-400 hover:text-sky-300"
						>info@worldsolvedcase.com</a
					>
				</p>
				<p>
					<span class="lang-es">o llamarnos al</span>
					<span class="lang-en">or call us at</span>
					<a
						href="tel:+18096334040"
						class="ml-1 text-sky-400 hover:text-sky-300"
						>+1 (809) 633-4040</a
					>
				</p>
			</div>
		</div>

		<div class="w-full lg:w-[58%]">
			<form
				class="rounded-xl border border-slate-800/80 bg-slate-900/70 p-6 shadow-xl shadow-slate-950/60 backdrop-blur-md sm:p-8"
				name="contact"
				method="POST"
				action="/api/subscribe"
				enctype="application/x-www-form-urlencoded"
				data-contact-form
			>
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="space-y-1.5">
						<label
							for="nombre"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Nombre</span><span
								class="lang-en">First name</span
							></label
						>
						<input
							id="nombre"
							name="firstName"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="apellido"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Apellido</span><span
								class="lang-en">Last name</span
							></label
						>
						<input
							id="apellido"
							name="lastName"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>
				</div>

				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					<div class="space-y-1.5">
						<label
							for="telefono"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Teléfono</span><span
								class="lang-en">Phone</span
							></label
						>
						<input
							id="telefono"
							name="phone"
							type="tel"
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="email"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Correo electrónico</span
							><span class="lang-en">Email address</span></label
						>
						<input
							id="email"
							name="email"
							type="email"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>
					<CountrySelect name="country" required />

					<div class="space-y-1.5">
						<label
							for="city"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Ciudad</span
							><span class="lang-en">City</span></label
						>
						<input
							id="city"
							name="city"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>
				</div>

				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					<div class="space-y-1.5">
						<label
							for="address"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Dirección</span
							><span class="lang-en">Address</span></label
						>
						<input
							id="address"
							name="address"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="identificationNumber"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Número de identificación</span
							><span class="lang-en">Identification number</span></label
						>
						<input
							id="identificationNumber"
							name="identificationNumber"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="city"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Plataforma</span
							><span class="lang-en">Platform</span></label
						>
						<input
							id="platform"
							name="platform"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="bankName"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Nombre de banco</span
							><span class="lang-en">Bank name</span></label
						>
						<input
							id="bankName"
							name="bankName"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="accountNumber"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Número de cuenta</span
							><span class="lang-en">Account number</span></label
						>
						<input
							id="accountNumber"
							name="accountNumber"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="swiftCode"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Código Swift de su banco</span
							><span class="lang-en">Bank Swift code</span></label
						>
						<input
							id="swiftCode"
							name="swiftCode"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="bankAddress"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Dirección de banco</span
							><span class="lang-en">Bank address</span></label
						>
						<input
							id="bankAddress"
							name="bankAddress"
							type="text"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="investedAmount"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Monto invertido</span
							><span class="lang-en">Invested amount</span></label
						>
						<input
							id="investedAmount"
							name="investedAmount"
							type="number"
							step="0.01"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>

					<div class="space-y-1.5">
						<label
							for="amountToRecover"
							class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
							><span class="lang-es">Monto a recuperar</span
							><span class="lang-en">Amount to recover</span></label
						>
						<input
							id="amountToRecover"
							name="amountToRecover"
							type="number"
							step="0.01"
							required
							class="w-full rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						/>
					</div>
				</div>

				<div class="mt-4 space-y-1.5">
					<label
						for="mensaje"
						class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300"
						><span class="lang-es">Mensaje</span><span
							class="lang-en">Message</span
						></label
					>
					<textarea
						id="mensaje"
						name="message"
						required
						rows={5}
						class="w-full resize-none rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 outline-none ring-0 transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
						placeholder="..."></textarea>
				</div>

				<div
					class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
				>
					<p class="text-[11px] text-slate-500">
						<span class="lang-es"
							>Al enviar aceptas nuestro trato responsable de tus
							datos.</span
						>
						<span class="lang-en"
							>By submitting, you agree to our responsible
							handling of your data.</span
						>
					</p>

					<button
						type="submit"
						class="inline-flex cursor-pointer items-center justify-center rounded-full bg-sky-500 px-7 py-2.5 text-xs font-semibold uppercase tracking-[0.22em] text-slate-950 shadow-lg shadow-sky-500/40 transition hover:bg-sky-400"
					>
						<span class="lang-es">Enviar mensaje</span>
						<span class="lang-en">Send message</span>
					</button>
				</div>

				<div data-form-message class="mt-4 hidden text-sm"></div>
			</form>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll('[data-contact-form]').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const msgEl = form.querySelector('[data-form-message]');
			const submitBtn = form.querySelector('button[type="submit"]');

			const setMessage = (text: string, isError: boolean) => {
				if (!msgEl) return;
				msgEl.textContent = text;
				msgEl.classList.toggle('text-red-400', isError);
				msgEl.classList.toggle('text-sky-400', !isError);
				msgEl.classList.remove('hidden');
			};

			if (submitBtn) {
				(submitBtn as HTMLButtonElement).disabled = true;
			}

			try {
				const formData = new FormData(form as HTMLFormElement);
				const params = new URLSearchParams();
				formData.forEach((value, key) => {
					if (typeof value === 'string') params.append(key, value);
				});
				const body = params.toString();

				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body,
				});

				const data = await res.json().catch(() => ({}));

				if (!res.ok) {
					const errText = data.error || (document.documentElement.getAttribute('data-lang') === 'es' ? 'Error al enviar.' : 'Failed to send.');
					setMessage(errText, true);
					return;
				}
				setMessage(
					document.documentElement.getAttribute('data-lang') === 'es'
						? 'Mensaje enviado correctamente.'
						: 'Message sent successfully.',
					false,
				);
				(form as HTMLFormElement).reset();
			} catch (err) {
				setMessage(
					document.documentElement.getAttribute('data-lang') === 'es' ? 'Error de conexión. Intenta de nuevo.' : 'Connection error. Please try again.',
					true,
				);
			} finally {
				if (submitBtn) {
					(submitBtn as HTMLButtonElement).disabled = false;
				}
			}
		});
	});
</script>
