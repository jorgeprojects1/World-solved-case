	{
		name: 'Justin Velázquez miller',
		roleEs: 'Licenciado en Derecho',
		roleEn: 'Lawyer',
		image: './images/team/justin.jpg',
	},
	{
		name: 'Ana Rodríguez',
		roleEs: 'Vicepresidenta',
		roleEn: 'Vice President',
		image: 'https://images.pexels.com/photos/3756679/pexels-photo-3756679.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Miguel Soto',
		roleEs: 'Gerente General',
		roleEn: 'General Manager',
		image: 'https://images.pexels.com/photos/3782179/pexels-photo-3782179.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Laura Fernández',
		roleEs: 'Directora Legal',
		roleEn: 'Legal Director',
		image: 'https://images.pexels.com/photos/3785077/pexels-photo-3785077.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Roberto García',
		roleEs: 'Director de Operaciones',
		roleEn: 'Director of Operations',
		image: 'https://images.pexels.com/photos/3785077/pexels-photo-3785077.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Patricia López',
		roleEs: 'Directora de Recursos Humanos',
		roleEn: 'Human Resources Director',
		image: 'https://images.pexels.com/photos/3781524/pexels-photo-3781524.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Fernando Martínez',
		roleEs: 'Director Financiero',
		roleEn: 'Chief Financial Officer',
		image: 'https://images.pexels.com/photos/3783250/pexels-photo-3783250.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Carmen Reyes',
		roleEs: 'Directora de Estrategia',
		roleEn: 'Strategy Director',
		image: 'https://images.pexels.com/photos/3785224/pexels-photo-3785224.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
	{
		name: 'Diego Herrera',
		roleEs: 'Director de Clientes',
		roleEn: 'Client Relations Director',
		image: 'https://images.pexels.com/photos/3782176/pexels-photo-3782176.jpeg?auto=compress&cs=tinysrgb&w=400',
	},
];
---

<section class="relative bg-slate-900 py-10 text-slate-50 sm:py-12 lg:py-14" id="equipo">
	<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-500/0 via-sky-500/60 to-sky-500/0"></div>

	<div class="relative mx-auto max-w-5xl px-6 lg:px-8">
		<div class="text-center">
			<p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-sky-400">World Solved Case</p>
			<h2 class="mt-2 text-xl  tracking-[0.18em] text-slate-50 sm:text-2xl">
				<span class="lang-es">NUESTRO EQUIPO</span>
				<span class="lang-en">OUR TEAM</span>
			</h2>
			<div class="mx-auto mt-2 h-0.5 w-14 bg-sky-500"></div>
			<p class="mx-auto mt-4 max-w-xl text-xs leading-relaxed text-slate-300 lang-es">
				Profesionales comprometidos con la excelencia y el servicio al cliente.
			</p>
			<p class="mx-auto mt-4 max-w-xl text-xs leading-relaxed text-slate-300 lang-en">
				Professionals committed to excellence and client service.
			</p>
		</div>

		<div class="mt-8 grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
			{team.map((member) => (
				<article class="group flex flex-col items-center rounded-lg border border-slate-700/60 bg-slate-800/50 px-3 py-4 shadow-md transition hover:border-sky-500/40">
					<div class="h-30 w-30 shrink-0 overflow-hidden rounded-full border-2 border-slate-600/70 bg-slate-700 ring-2 ring-slate-800">
						<img
							src={member.image}
							alt={member.name}
							class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
							loading="lazy"
						/>
					</div>
					<h3 class="mt-3 text-center text-sm font-semibold text-slate-50">
						{member.name}
					</h3>
					<p class="mt-0.5 text-center text-[10px] font-medium uppercase tracking-[0.14em] text-sky-400">
						<span class="lang-es">{member.roleEs}</span>
						<span class="lang-en">{member.roleEn}</span>
					</p>
				</article>
			))}
		</div>
	</div>
</section>
