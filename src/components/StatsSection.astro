---
// Clientes satisfechos: 750 ahora, +7 por cada mes que pase (sin tope)
const startDate = new Date('2025-03-01');
const now = new Date();
const monthsElapsed = Math.max(0, (now.getFullYear() - startDate.getFullYear()) * 12 + (now.getMonth() - startDate.getMonth()));
const satisfiedClients = 750 + monthsElapsed * 7;

const stats = [
	{
		value: 30,
		labelEs: 'Años de experiencia',
		labelEn: 'Years of experience',
		icon: 'scale',
	},
	{
		value: 56,
		labelEs: 'Miembros expertos',
		labelEn: 'Expert members',
		icon: 'team',
	},
	{
		value: satisfiedClients,
		labelEs: 'Clientes satisfechos',
		labelEn: 'Satisfied clients',
		icon: 'clients',
	},
];
---

<section
	class="relative bg-white py-16 text-slate-50 sm:py-18 lg:py-20"
>
	<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-500/0 via-sky-500/60 to-sky-500/0"></div>

	<div class="relative mx-auto flex max-w-6xl flex-col gap-10 px-6 lg:flex-row lg:items-center lg:gap-20 lg:px-8">
		<div class="max-w-md">
			<p class="text-xs  uppercase tracking-[0.3em] text-sky-400">
				World Solved Case
			</p>
			<h2 class="mt-3 text-2xl  tracking-[0.2em] text-sky-500 sm:text-3xl">
				<span class="lang-es">RESULTADOS RESPALDADOS POR EXPERIENCIA</span>
				<span class="lang-en">RESULTS BACKED BY EXPERIENCE</span>
			</h2>
			<p class="mt-4 text-sm leading-relaxed text-slate-700 sm:text-base lang-es">
				Más de tres décadas acompañando a empresas y personas en decisiones legales complejas, con un equipo
				enfocado en estrategia, precisión y cercanía humana.
			</p>
			<p class="mt-4 text-sm leading-relaxed text-slate-700 sm:text-base lang-en">
				Over three decades supporting companies and individuals through complex legal decisions, with a team
				focused on strategy, precision, and human connection.
			</p>
		</div>

		<div class="grid flex-1 gap-6 sm:grid-cols-3" data-stats-root>
			{stats.map((item, index) => (
				<div
					class="flex items-center sm:flex-col sm:items-start gap-3 rounded-xl border border-slate-800/80 bg-slate-900/90 px-5 py-4 shadow-lg shadow-black/60 backdrop-blur-md"
				>
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-sky-500/90 text-slate-950">
						{item.icon === 'scale' && (
							<svg viewBox="0 0 24 24" class="h-5 w-5">
								<path
									fill="currentColor"
									d="M11 3h2v3h3v2h-3v9h4v2H7v-2h4V8H8V6h3V3ZM5 8l3 7H2l3-7Zm14 0l3 7h-6l3-7Z"
								/>
							</svg>
						)}
						{item.icon === 'team' && (
							<svg viewBox="0 0 24 24" class="h-5 w-5">
								<path
									fill="currentColor"
									d="M8 5a3 3 0 1 1-3 3a3 3 0 0 1 3-3Zm8 0a3 3 0 1 1-3 3a3 3 0 0 1 3-3Zm-8 7a4 4 0 0 1 4 4v3H4v-3a4 4 0 0 1 4-4Zm8 0a4 4 0 0 1 4 4v3h-8v-3a4 4 0 0 1 4-4Z"
								/>
							</svg>
						)}
						{item.icon === 'clients' && (
							<svg viewBox="0 0 24 24" class="h-5 w-5">
								<path
									fill="currentColor"
									d="M12 4a3 3 0 1 1-3 3a3 3 0 0 1 3-3Zm0 7a4 4 0 0 1 4 4v3H8v-3a4 4 0 0 1 4-4Zm7-5a2.5 2.5 0 1 1-2.5 2.5A2.5 2.5 0 0 1 19 6Zm-14 0A2.5 2.5 0 1 1 2.5 8.5A2.5 2.5 0 0 1 5 6Zm12.5 7A3.5 3.5 0 0 1 21 16.5V18h-3.5v-1.5a5.5 5.5 0 0 0-.82-2.9A3.48 3.48 0 0 1 17.5 13ZM2.5 16.5A3.5 3.5 0 0 1 6 13a3.48 3.48 0 0 1 .82.55A5.5 5.5 0 0 0 6 16.5V18H2.5Z"
								/>
							</svg>
						)}
					</div>
					<p
						class="text-3xl  tracking-tight text-sky-400 sm:text-6xl"
						data-stat-value
						data-target={item.value}
					>
						0
					</p>
					<p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">
						<span class="lang-es">{item.labelEs}</span>
						<span class="lang-en">{item.labelEn}</span>
					</p>
				</div>
			))}
		</div>
	</div>
</section>

<script type="module">
	document.addEventListener('DOMContentLoaded', () => {
		const root = document.querySelector('[data-stats-root]');
		if (!root) return;

		const counters = Array.from(root.querySelectorAll('[data-stat-value]'));
		if (!counters.length) return;

		const formatNumber = (n) => n.toLocaleString('es-ES', { maximumFractionDigits: 0 });

		const animateCounter = (el) => {
			const target = Number(el.getAttribute('data-target') || '0');
			if (!target) return;

			const duration = target >= 10000 ? 2500 : 1500;
			const startTime = performance.now();

			const step = (now) => {
				const progress = Math.min(1, (now - startTime) / duration);
				const eased = 1 - Math.pow(1 - progress, 1.5);
				const value = Math.floor(eased * target);
				el.textContent = formatNumber(value);
				if (progress < 1) {
					requestAnimationFrame(step);
				} else {
					el.textContent = formatNumber(target);
				}
			};

			requestAnimationFrame(step);
		};

		let started = false;
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && !started) {
						started = true;
						counters.forEach(animateCounter);
					}
				});
			},
			{ threshold: 0.3 },
		);

		observer.observe(root);
	});
</script>

