---

---

<header
	class="fixed inset-x-0 top-0 z-30 border-b border-slate-800/60 bg-slate-950/80 backdrop-blur-md"
	data-site-header
>
	<!-- Barra superior: correo y teléfono -->
	<div class="border-b border-slate-800/50 bg-slate-900/50">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-1 px-4 py-2 text-xs text-slate-400 sm:justify-end lg:px-8">
			<a href="mailto:info@worldsolvedcase.com" class="inline-flex sm:text-lg items-center gap-2 transition hover:text-sky-400">
				<svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
				</svg>
				<span>support@worldsolvedcase.com</span>
			</a>
			<a href="tel:+16179458584" class="inline-flex items-center sm:text-lg gap-2 transition hover:text-sky-400">
				<svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
				</svg>
				<span>+1 (617) 945-8584</span>
			</a>
		</div>
	</div>
	<div
		class="menupadding mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4 lg:px-8 lg:py-6"
	>
		<a href="/" class="flex items-center gap-3">
			<!-- <div
				class="flex h-10 w-10 items-center justify-center rounded-sm bg-sky-500 text-sm font-semibold tracking-wide"
			>
				WSC
			</div> -->
			<img
				src="/images/logo.png"
				alt="Equipo legal en reunión"
				class="relative z-10 w-15  h-15 sm:h-20 sm:w-20 object-cover"
				loading="lazy"
			/>
			<div class="leading-tight hidden md:block">
				<p
					class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-200"
					
				>
					<span class="lang-es">World Solved Case</span>
					<span class="lang-en">World Solved Case</span>
				</p>
				<p class="text-xs text-slate-400">
					<span class="lang-es">Abogados | Consultores</span>
					<span class="lang-en">Attorneys | Consultants</span>
				</p>
			</div>
		</a>

		<nav
			class="hidden items-center gap-8 text-xs font-medium uppercase tracking-[0.18em] text-slate-200 md:flex"
		>
			<a href="/#nosotros" class="transition-colors hover:text-white">
				<span class="lang-es">Nosotros</span>
				<span class="lang-en">About us</span>
			</a>
			<a href="/#services" class="transition-colors hover:text-white">
				<span class="lang-es">Servicios</span>
				<span class="lang-en">Services</span>
			</a>
			<a href="/#equipo" class="transition-colors hover:text-white">
				<span class="lang-es">Equipo</span>
				<span class="lang-en">Team</span>
			</a>

			<a
				href="#english"
				class="transition-colors hover:text-white"
				data-lang-toggle
			>
				<span class="lang-es">English</span>
				<span class="lang-en">Español</span>
			</a>
		</nav>

		<div class="flex items-center gap-4">
			<div class="hidden items-center gap-3 text-slate-300 md:flex">
				<button
					class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-600/70 bg-slate-900/50 text-[10px] uppercase tracking-[0.18em] text-slate-200 shadow-sm transition hover:border-sky-400 hover:text-white"
					aria-label="Instagram"
				>
					IG
				</button>
				<button
					class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-600/70 bg-slate-900/50 text-[10px] uppercase tracking-[0.18em] text-slate-200 shadow-sm transition hover:border-sky-400 hover:text-white"
					aria-label="Facebook"
				>
					Fb
				</button>
			</div>

			<a
				href="/subscribe"
				class="hidden rounded-full bg-sky-500 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-950 shadow-lg shadow-sky-500/30 transition hover:bg-sky-400 sm:inline-flex"
			>
				<span class="lang-es">Suscribirse</span>
				<span class="lang-en">Subscribe</span>
			</a>

			<!-- Botón hamburguesa mobile -->
			<button
				type="button"
				class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-700/80 bg-slate-900/70 text-slate-100 shadow-sm transition hover:border-sky-400 hover:text-white md:hidden"
				data-mobile-toggle
				aria-label="Abrir menú"
				aria-expanded="false"
			>
				<span class="relative block h-3.5 w-4">
					<span
						class="absolute inset-x-0 top-0 h-0.5 rounded bg-sky-400 transition-transform"
						data-line="1"></span>
					<span
						class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 rounded bg-sky-400 transition-opacity"
						data-line="2"></span>
					<span
						class="absolute inset-x-0 bottom-0 h-0.5 rounded bg-sky-400 transition-transform"
						data-line="3"></span>
				</span>
			</button>
		</div>
	</div>

	<!-- Menú mobile -->
	<div
		class="pointer-events-none absolute inset-x-0 top-full origin-top transform bg-slate-950/98 px-6 pb-5 pt-2 text-sm opacity-0 shadow-lg shadow-black/40 ring-1 ring-slate-800/80 backdrop-blur-md transition duration-200 md:hidden"
		data-mobile-nav
	>
		<nav
			class="flex flex-col gap-2 text-xs font-medium justify-center text-center uppercase tracking-[0.2em] text-slate-100"
		>
			<a
				href="/#nosotros"
				class="py-1.5 transition-colors hover:text-sky-300"
			>
				<span class="lang-es">Nosotros</span>
				<span class="lang-en">About us</span>
			</a>

			<a
				href="/#services"
				class="py-1.5 transition-colors hover:text-sky-300"
			>
				<span class="lang-es">Servicios</span>
				<span class="lang-en">Services</span>
			</a>
			<a
				href="/#equipo"
				class="py-1.5 transition-colors hover:text-sky-300"
			>
				<span class="lang-es">Equipo</span>
				<span class="lang-en">Team</span>
			</a>

			<a
				href="#english"
				class="py-1.5 transition-colors hover:text-sky-300"
				data-lang-toggle
			>
				<span class="lang-es">English</span>
				<span class="lang-en">Español</span>
			</a>
		</nav>

		<a
			href="/subscribe"
			class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-sky-500 px-5 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-950 shadow-md shadow-sky-500/40 transition hover:bg-sky-400"
		>
			<span class="lang-es">Suscribirse</span>
			<span class="lang-en">Subscribe</span>
		</a>
	</div>

	<script type="module">
		
		// Shrink header on scroll down, restore on scroll up/top y remueve el style al volver al top
		let shrinkStyleEl = null;

		document.addEventListener("DOMContentLoaded", () => {
			const header = document.querySelector("[data-site-header]");
			if (!header) return;

			let isShrunk = false;

			const applyShrink = () => {
				if (!isShrunk) {
					header.classList.add("header-shrink");
					// Insert style for menupadding if not already present
					if (!shrinkStyleEl) {
						shrinkStyleEl = document.createElement("style");
						shrinkStyleEl.innerHTML = `
							.menupadding {
								padding-top: calc(var(--header-padding-top, 15px) - 8px) !important;
								padding-bottom: calc(var(--header-padding-bottom, 15px ) - 8px) !important;
								transition: padding 0.25s cubic-bezier(0.4,0,0.2,1);
							}
						`;
						document.head.appendChild(shrinkStyleEl);
					}
					isShrunk = true;
				}
			};

			const removeShrink = () => {
				if (isShrunk) {
					header.classList.remove("header-shrink");
					// Remove shrink style if it exists
					if (shrinkStyleEl) {
						shrinkStyleEl.remove();
						shrinkStyleEl = null;
					}
					isShrunk = false;
				}
			};

			window.addEventListener("scroll", () => {
				const currentScroll = window.scrollY || window.pageYOffset;
				if (currentScroll > 16) {
					applyShrink();
				} else {
					removeShrink();
				}
			});
		});

		document.addEventListener("DOMContentLoaded", () => {
			const header = document.querySelector("[data-site-header]");
			if (!header) return;

			const mobileToggle = header.querySelector("[data-mobile-toggle]");
			const mobileNav = header.querySelector("[data-mobile-nav]");
			const langToggles = header.querySelectorAll("[data-lang-toggle]");

			if (!mobileToggle || !mobileNav) return;

			const line1 = mobileToggle.querySelector('[data-line="1"]');
			const line2 = mobileToggle.querySelector('[data-line="2"]');
			const line3 = mobileToggle.querySelector('[data-line="3"]');

			const setMenuState = (open) => {
				mobileNav.style.opacity = open ? "1" : "0";
				mobileNav.style.pointerEvents = open ? "auto" : "none";
				mobileNav.style.transform = open ? "scaleY(1)" : "scaleY(0.9)";
				mobileToggle.setAttribute(
					"aria-expanded",
					open ? "true" : "false",
				);

				if (line1 && line3 && line2) {
					line1.style.transform = open
						? "translateY(7px) rotate(45deg)"
						: "translateY(0) rotate(0deg)";
					line3.style.transform = open
						? "translateY(-7px) rotate(-45deg)"
						: "translateY(0) rotate(0deg)";
					line2.style.opacity = open ? "0" : "1";
				}
			};

			let open = false;

			mobileToggle.addEventListener("click", () => {
				open = !open;
				setMenuState(open);
			});

			// Cerrar al hacer click en un link
			mobileNav.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", () => {
					open = false;
					setMenuState(false);
				});
			});

			// Language toggle
			const applyLang = (lang) => {
				document.documentElement.setAttribute("data-lang", lang);
				try {
					window.localStorage.setItem("siteLang", lang);
				} catch {}
			};

			const stored = (() => {
				try {
					return window.localStorage.getItem("siteLang");
				} catch {
					return null;
				}
			})();

			// Default to English on first load; use stored preference if present
			applyLang(stored === "es" ? "es" : "en");

			langToggles.forEach((el) => {
				el.addEventListener("click", (event) => {
					event.preventDefault();
					const current =
						document.documentElement.getAttribute("data-lang") ===
						"en"
							? "en"
							: "es";
					const next = current === "es" ? "en" : "es";
					applyLang(next);
				});
			});
		});
	</script>
</header>
