---
---

<footer class="bg-black text-slate-100">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 md:flex-row md:items-center md:justify-between lg:px-8">
		<div class="flex items-center gap-3">
			<div
				class="flex h-12 w-12 items-center justify-center rounded-sm bg-sky-500 text-base font-semibold tracking-wide"
			>
				WSC
			</div>
			<div class="leading-tight">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-100">
					<span class="lang-es">World Solved Case</span>
					<span class="lang-en">World Solved Case</span>
				</p>
				<p class="text-xs text-slate-400">
					<span class="lang-es">Abogados | Consultores</span>
					<span class="lang-en">Attorneys | Consultants</span>
				</p>
			</div>
		</div>

		<div class="grid flex-1 gap-6 text-xs uppercase tracking-[0.18em] text-slate-300 sm:grid-cols-3 md:gap-10">
			<div class="space-y-1">
				<p class="text-[11px] font-semibold text-sky-400">
					<span class="lang-es">Contacto</span>
					<span class="lang-en">Contact</span>
				</p>
				<p class="text-[11px] normal-case text-slate-100">
					<a href="mailto:info@worldsolvedcase.com" class="hover:text-sky-400">info@worldsolvedcase.com</a>
					<br />
					<a href="tel:+18096334040" class="hover:text-sky-400">+1 (809) 633-4040</a>
				</p>
			</div>

			<div class="space-y-1">
				<p class="text-[11px] font-semibold text-sky-400">
					<span class="lang-es">Dirección</span>
					<span class="lang-en">Address</span>
				</p>
				<p class="text-[11px] normal-case text-slate-200">
					Gustavo Mejía Ricart #69, Torre Washington
					<br />
					4to piso, Suite 4A, Santo Domingo,
					<br />
					<span class="font-semibold">
						<span class="lang-es">República Dominicana</span>
						<span class="lang-en">Dominican Republic</span>
					</span>
				</p>
			</div>

			<div class="space-y-1">
				<p class="text-[11px] font-semibold text-sky-400">
					<span class="lang-es">Horario</span>
					<span class="lang-en">Business hours</span>
				</p>
				<p class="text-[11px] normal-case text-slate-200">
					<span class="lang-es">Lunes - Viernes</span>
					<span class="lang-en">Monday - Friday</span>
					<br />
					9:00 A.M – 5:00 P.M
				</p>
			</div>
		</div>

		<div class="flex items-center gap-4 text-slate-300">
			<button
				class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-600/70 bg-slate-900/60 text-[11px] uppercase tracking-[0.18em] text-slate-200 shadow-sm transition hover:border-sky-400 hover:text-white"
				aria-label="Instagram"
			>
				IG
			</button>
			<button
				class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-600/70 bg-slate-900/60 text-[11px] uppercase tracking-[0.18em] text-slate-200 shadow-sm transition hover:border-sky-400 hover:text-white"
				aria-label="Facebook"
			>
				Fb
			</button>
		</div>
	</div>

	<div class="border-t border-slate-800/80 bg-slate-950/95">
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3 text-[10px] text-slate-500 lg:px-8">
			<p>
				&copy; {new Date().getFullYear()} World Solved Case.
				<span class="lang-es"> Todos los derechos reservados.</span>
				<span class="lang-en"> All rights reserved.</span>
			</p>
			<p class="hidden sm:block">
				<span class="lang-es">Diseñado para firmas legales modernas.</span>
				<span class="lang-en">Designed for modern law firms.</span>
			</p>
		</div>
	</div>
</footer>

