---
const images = [
	'https://images.pexels.com/photos/3756678/pexels-photo-3756678.jpeg?auto=compress&cs=tinysrgb&w=800',
	'https://images.pexels.com/photos/3184292/pexels-photo-3184292.jpeg?auto=compress&cs=tinysrgb&w=800',
	'https://images.pexels.com/photos/3184360/pexels-photo-3184360.jpeg?auto=compress&cs=tinysrgb&w=800',
	'https://images.pexels.com/photos/3760263/pexels-photo-3760263.jpeg?auto=compress&cs=tinysrgb&w=800',
];
---

<section
	class="relative bg-slate-900 py-16 text-slate-50 sm:py-20 lg:py-24 section-animate-init"
	data-animate-section
>
	<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-500/0 via-sky-500/60 to-sky-500/0"></div>

	<div class="relative mx-auto max-w-6xl px-6 lg:px-8">
		<div class="flex flex-col gap-12 lg:flex-row lg:items-center lg:gap-16">
			<!-- Texto -->
			<div class="w-full lg:w-[52%]">
				<h2 class="text-2xl tracking-[0.2em] text-sky-400 sm:text-3xl">
					<span class="lang-es">RECUPERACIÓN MONETARIA GLOBAL</span>
					<span class="lang-en">GLOBAL MONETARY RECOVERY</span>
				</h2>
				<div class="mt-3 h-0.5 w-24 bg-sky-500"></div>

				<div class="mt-6 space-y-4 text-sm leading-relaxed text-slate-300 sm:text-base">
					<p class="lang-es">
						Garantiza tu recuperación monetaria con los mejores servicios de nuestro personal en todas partes del mundo, con las mejores jurisdicciones para poder procesar un caso judicial en Latinoamérica como en Europa y Estados Unidos. Cuenta con nosotros para cualquier servicio de recuperación.
					</p>
					<p class="lang-en">
						Secure your monetary recovery with the best services from our team worldwide, with the best jurisdictions to process a legal case in Latin America as well as in Europe and the United States. Count on us for any recovery service.
					</p>
				</div>
			</div>

			<!-- Imágenes con fade -->
			<div class="w-full lg:w-[48%]">
				<div class="relative aspect-[4/3] overflow-hidden rounded-xl border border-slate-700/60 bg-slate-800/50 shadow-xl" data-recovery-container>
					{images.map((src, i) => (
						<div
							class="absolute inset-0 z-0 transition-opacity duration-700 ease-in-out"
							style={i === 0 ? 'opacity: 1' : 'opacity: 0'}
							data-recovery-slide
							data-index={i}
							aria-hidden={i !== 0}
						>
							<img
								src={src}
								alt=""
								class="h-full w-full object-cover"
								loading="lazy"
								width={800}
								height={600}
							/>
							<div class="absolute inset-0 bg-slate-900/20"></div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const container = document.querySelector('[data-recovery-container]');
		if (!container) return;

		const slides = container.querySelectorAll('[data-recovery-slide]');
		const total = slides.length;
		if (total === 0) return;

		let index = 0;

		const show = (i: number) => {
			slides.forEach((el, j) => {
				const isActive = j === i;
				const htmlEl = el as HTMLElement;
				htmlEl.style.opacity = isActive ? '1' : '0';
				htmlEl.style.zIndex = isActive ? '10' : '0';
				el.setAttribute('aria-hidden', String(!isActive));
			});
		};

		const interval = setInterval(() => {
			index = (index + 1) % total;
			show(index);
		}, 4500);
	});
</script>
