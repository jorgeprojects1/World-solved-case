---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="World solved case" />
		<meta name="keywords" content="World solved case, World solved case, World solved case" />
		<meta name="author" content="World solved case" />
		<title>World solved case</title>
	</head>
	<body class="bg-slate-950 text-slate-50">
		<slot />
		<Footer />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReducedMotion) return;

				const elements = document.querySelectorAll('[data-animate-section]');
				if (!elements.length) return;

				const observer = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('section-animate-visible');
								obs.unobserve(entry.target);
							}
						});
					},
					{
						threshold: 0.15,
					},
				);

				elements.forEach((el, index) => {
					(el as HTMLElement).style.transitionDelay = `${index * 70}ms`;
					observer.observe(el);
				});
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;	
		height: 100%;
	}
</style>
