---
interface Props {
	name?: string;
	required?: boolean;
	placeholderEs?: string;
	placeholderEn?: string;
}

const { name = 'country', required = false, placeholderEs = 'Buscar país...', placeholderEn = 'Search country...' } = Astro.props;

// Lista de países: código ISO 3166-1 alpha-2 y nombre
const countries = [
	{ code: 'DO', name: 'República Dominicana' },
	{ code: 'US', name: 'Estados Unidos' },
	{ code: 'ES', name: 'España' },
	{ code: 'MX', name: 'México' },
	{ code: 'CO', name: 'Colombia' },
	{ code: 'AR', name: 'Argentina' },
	{ code: 'PE', name: 'Perú' },
	{ code: 'VE', name: 'Venezuela' },
	{ code: 'CL', name: 'Chile' },
	{ code: 'EC', name: 'Ecuador' },
	{ code: 'GT', name: 'Guatemala' },
	{ code: 'CU', name: 'Cuba' },
	{ code: 'BO', name: 'Bolivia' },
	{ code: 'HN', name: 'Honduras' },
	{ code: 'PY', name: 'Paraguay' },
	{ code: 'SV', name: 'El Salvador' },
	{ code: 'NI', name: 'Nicaragua' },
	{ code: 'CR', name: 'Costa Rica' },
	{ code: 'PA', name: 'Panamá' },
	{ code: 'UY', name: 'Uruguay' },
	{ code: 'PR', name: 'Puerto Rico' },
	{ code: 'JM', name: 'Jamaica' },
	{ code: 'HT', name: 'Haití' },
	{ code: 'TT', name: 'Trinidad y Tobago' },
	{ code: 'BS', name: 'Bahamas' },
	{ code: 'BB', name: 'Barbados' },
	{ code: 'BR', name: 'Brasil' },
	{ code: 'CA', name: 'Canadá' },
	{ code: 'GB', name: 'Reino Unido' },
	{ code: 'FR', name: 'Francia' },
	{ code: 'DE', name: 'Alemania' },
	{ code: 'IT', name: 'Italia' },
	{ code: 'NL', name: 'Países Bajos' },
	{ code: 'BE', name: 'Bélgica' },
	{ code: 'PT', name: 'Portugal' },
	{ code: 'CH', name: 'Suiza' },
	{ code: 'CN', name: 'China' },
	{ code: 'JP', name: 'Japón' },
	{ code: 'IN', name: 'India' },
	{ code: 'AU', name: 'Australia' },
	{ code: 'RU', name: 'Rusia' },
	{ code: 'ZA', name: 'Sudáfrica' },
	{ code: 'OT', name: 'Otro' },
].sort((a, b) => a.name.localeCompare(b.name));
---

<div class="space-y-1.5" data-country-select>
	<label for={`${name}-trigger`} class="block text-xs font-semibold uppercase tracking-[0.2em] text-slate-300">
		<span class="lang-es">País</span>
		<span class="lang-en">Country</span>
	</label>
	<input
		type="hidden"
		name={name}
		id={`${name}-value`}
		value=""
		required={required}
		data-country-input
	/>

	<div class="relative">
		<button
			type="button"
			id={`${name}-trigger`}
			class="flex w-full items-center gap-2 rounded-md border border-slate-700/70 bg-slate-900/70 px-3 py-2 text-left text-sm text-slate-50 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/40"
			data-country-trigger
			aria-haspopup="listbox"
			aria-expanded="false"
			aria-labelledby={`${name}-trigger`}
		>
			<span class="text-base leading-none" data-country-flag aria-hidden="true">🌐</span>
			<span class="flex-1 truncate text-slate-300" data-country-label>
				<span class="lang-es">{placeholderEs}</span>
				<span class="lang-en">{placeholderEn}</span>
			</span>
			<svg class="h-4 w-4 shrink-0 text-slate-400 transition data-open:rotate-180" data-country-chevron fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
			</svg>
		</button>

		<div
			class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-64 flex-col overflow-hidden rounded-md border border-slate-700/70 bg-slate-900 shadow-xl"
			data-country-dropdown
		>
			<div class="border-b border-slate-700/70 p-2">
				<input
					type="text"
					class="w-full rounded border border-slate-600/70 bg-slate-800/80 px-3 py-1.5 text-sm text-slate-50 placeholder-slate-500 outline-none focus:border-sky-500"
					placeholder="..."
					data-country-search
					aria-label="Buscar país"
				/>
			</div>
			<ul
				class="max-h-48 overflow-y-auto py-1"
				role="listbox"
				aria-label="Países"
				data-country-list
			>
				{countries.map((c) => {
					const flag = [...c.code].map((char) => String.fromCodePoint(127397 + char.charCodeAt(0))).join('');
					return (
						<li
							role="option"
							class="flex cursor-pointer items-center gap-2 px-3 py-2 text-sm text-slate-200 hover:bg-slate-800/80 focus:bg-slate-800/80"
							data-country-option
							data-code={c.code}
							data-name={c.name}
							tabindex="-1"
						>
							<span class="text-base leading-none" aria-hidden="true">{flag}</span>
							<span>{c.name}</span>
						</li>
					);
				})}
			</ul>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('[data-country-select]').forEach((root) => {
			const trigger = root.querySelector('[data-country-trigger]');
			const dropdown = root.querySelector('[data-country-dropdown]');
			const input = root.querySelector('[data-country-input]') as HTMLInputElement | null;
			const label = root.querySelector('[data-country-label]') as HTMLElement | null;
			const flagEl = root.querySelector('[data-country-flag]') as HTMLElement | null;
			const search = root.querySelector('[data-country-search]') as HTMLInputElement | null;
			const list = root.querySelector('[data-country-list]');
			const options = root.querySelectorAll('[data-country-option]');
			const chevron = root.querySelector('[data-country-chevron]');

			if (!trigger || !dropdown || !input) return;

			const open = () => {
				dropdown.classList.remove('hidden');
				dropdown.classList.add('flex');
				trigger.setAttribute('aria-expanded', 'true');
				chevron?.setAttribute('data-open', '');
				search?.focus();
			};

			const close = () => {
				dropdown.classList.add('hidden');
				dropdown.classList.remove('flex');
				trigger.setAttribute('aria-expanded', 'false');
				chevron?.removeAttribute('data-open');
				if (search) search.value = '';
				options.forEach((o) => o.classList.remove('hidden'));
			};

			const setValue = (code: string, name: string, flagUnicode: string) => {
				input.value = name;
				if (label) label.textContent = name;
				if (flagEl) flagEl.textContent = flagUnicode || '🌐';
				close();
			};

			trigger.addEventListener('click', (e) => {
				e.preventDefault();
				if (dropdown.classList.contains('hidden')) open();
				else close();
			});

			search?.addEventListener('input', () => {
				const q = (search?.value ?? '').trim().toLowerCase();
				options.forEach((opt) => {
					const name = (opt.getAttribute('data-name') || '').toLowerCase();
					opt.classList.toggle('hidden', Boolean(q && !name.includes(q)));
				});
			});

			options.forEach((opt) => {
				opt.addEventListener('click', () => {
					const code = opt.getAttribute('data-code') || '';
					const name = opt.getAttribute('data-name') || '';
					const flag = [...code].map((c) => String.fromCodePoint(127397 + c.charCodeAt(0))).join('');
					setValue(code, name, code.length === 2 ? flag : '🌐');
				});
			});

			document.addEventListener('click', (e) => {
				if (!(e.target instanceof Node) || !root.contains(e.target)) close();
			});
		});
	});
</script>
